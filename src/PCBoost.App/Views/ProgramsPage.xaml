<local:ViewPage
    x:Class="PCBoost.App.Views.ProgramsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PCBoost.App.Views"
    xmlns:h="using:PCBoost.App.Helpers"
    xmlns:controls="using:PCBoost.App.Controls"
    xmlns:vm="using:PCBoost.Presentation.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{StaticResource ContentMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="18">
            <Grid ColumnSpacing="16" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock Text="{h:Str Key=Programs_Title}" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Text="{h:Str Key=Programs_Subtitle}" Style="{StaticResource PageSubtitleTextStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{x:Bind ViewModel.ReadLastRunCommand}"
                            ToolTipService.ToolTip="{h:Str Key=Programs_Action_ReadLastRun_ToolTip}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEA18;" FontSize="14" />
                            <TextBlock Text="{h:Str Key=Programs_Action_ReadLastRun}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{x:Bind ViewModel.RefreshCommand}"
                            ToolTipService.ToolTip="{h:Str Key=Common_Action_Refresh}" AutomationProperties.Name="{h:Str Key=Common_Action_Refresh}">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <InfoBar Severity="Error" h:InfoBarHelper.IsShown="{x:Bind ViewModel.HasError, Mode=OneWay}" Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                     Title="{h:Str Key=Common_Label_ErrorTitle}" CloseButtonCommand="{x:Bind ViewModel.DismissErrorCommand}" />
            <InfoBar Severity="Success" h:InfoBarHelper.IsShown="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}" Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                     CloseButtonCommand="{x:Bind ViewModel.DismissStatusCommand}" />
            <InfoBar Severity="Informational" IsClosable="False" Title="{x:Bind ViewModel.UninstallingText, Mode=OneWay}" Message="{h:Str Key=Programs_Uninstalling_Hint}"
                     h:InfoBarHelper.IsShown="{x:Bind ViewModel.IsUninstalling, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="{h:Str Key=Programs_Action_StopWaiting}" Command="{x:Bind ViewModel.StopWaitingCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar Severity="Warning" IsOpen="True" IsClosable="False" Message="{h:Str Key=Programs_Notice}" />

            <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <AutoSuggestBox PlaceholderText="{h:Str Key=Programs_Search_Placeholder}" QueryIcon="Find" MaxWidth="360" HorizontalAlignment="Left"
                                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" AutomationProperties.Name="{h:Str Key=Programs_Search_Placeholder}" />
                <ToggleButton Grid.Column="1" IsChecked="{x:Bind ViewModel.RarelyUsedOnly, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE823;" FontSize="14" />
                        <TextBlock Text="{h:Str Key=Programs_Filter_RarelyUsed}" />
                    </StackPanel>
                </ToggleButton>
                <ComboBox Grid.Column="2" ItemsSource="{x:Bind ViewModel.SortOptions}" SelectedIndex="{x:Bind ViewModel.SelectedSortIndex, Mode=TwoWay}"
                          MinWidth="220" AutomationProperties.Name="{h:Str Key=Programs_Sort_Label}" />
            </Grid>
            <StackPanel Spacing="2" Margin="0,-6,0,0">
                <TextBlock Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" Style="{StaticResource CaptionSecondaryTextStyle}" />
                <TextBlock Text="{x:Bind ViewModel.LastRunText, Mode=OneWay}" Style="{StaticResource CaptionSecondaryTextStyle}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.HiddenText, Mode=OneWay}" Style="{StaticResource CaptionSecondaryTextStyle}" TextWrapping="Wrap"
                           Visibility="{x:Bind h:Ui.ShowText(ViewModel.HiddenText), Mode=OneWay}" />
            </StackPanel>

            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind h:Ui.Show(ViewModel.IsLoading), Mode=OneWay}" />

            <Border Style="{StaticResource SubtleSurfaceStyle}" Visibility="{x:Bind h:Ui.Show(ViewModel.ShowEmpty), Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="20,2,20,2" Visibility="{x:Bind h:Ui.ShowCount(ViewModel.Items.Count), Mode=OneWay}">
                <ItemsControl h:ListDividers.HideLast="True" ItemsSource="{x:Bind ViewModel.Items}" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProgramItemViewModel">
                            <Border Padding="0,12,0,12" AutomationProperties.Name="{x:Bind AccessibleName}"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource GroupHeaderTextStyle}" TextTrimming="CharacterEllipsis" />
                                            <controls:StatusBadge Text="{x:Bind RarelyUsedBadge}" Glyph="&#xE823;" Kind="Caution" Visibility="{x:Bind h:Ui.Show(IsRarelyUsed)}" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind DetailsText}" Style="{StaticResource CaptionSecondaryTextStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource CaptionSecondaryTextStyle}" TextWrapping="Wrap">
                                            <Run Text="{x:Bind LastUsedText}" /><Run Text="  " /><Run Text="{x:Bind LastUsedHint}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </TextBlock>
                                        <TextBlock Text="{x:Bind UninstallUnavailableText}" Style="{StaticResource CaptionSecondaryTextStyle}" TextWrapping="Wrap"
                                                   Visibility="{x:Bind h:Ui.ShowText(UninstallUnavailableText)}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="96">
                                        <TextBlock Text="{x:Bind SizeText}" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Right" />
                                        <TextBlock Text="{x:Bind SizeHint}" Style="{StaticResource CaptionSecondaryTextStyle}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <Grid Grid.Column="2" VerticalAlignment="Center" MinWidth="130">
                                        <Button Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Content="{h:Str Key=Programs_Action_Uninstall}"
                                                Command="{x:Bind UninstallCommand}" Visibility="{x:Bind h:Ui.Show(CanUninstall)}"
                                                AutomationProperties.Name="{h:Str Key=Programs_Action_Uninstall}" />
                                        <ProgressRing IsActive="{x:Bind IsBusy, Mode=OneWay}" Width="20" Height="20" HorizontalAlignment="Left" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <HyperlinkButton Content="{h:Str Key=Programs_Action_WindowsSettings}" Command="{x:Bind ViewModel.OpenWindowsSettingsCommand}" />
        </StackPanel>
    </ScrollViewer>
</local:ViewPage>
