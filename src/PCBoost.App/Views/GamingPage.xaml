<local:ViewPage
    x:Class="PCBoost.App.Views.GamingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PCBoost.App.Views"
    xmlns:h="using:PCBoost.App.Helpers"
    xmlns:controls="using:PCBoost.App.Controls"
    xmlns:vm="using:PCBoost.Presentation.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{StaticResource ContentMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="22">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE7FC;" FontSize="26" Foreground="{ThemeResource SessionAccentTextBrush}" />
                        <TextBlock Text="{h:Str Key=Gaming_Title}" Style="{StaticResource PageTitleTextStyle}" />
                    </StackPanel>
                    <TextBlock Text="{h:Str Key=Gaming_Subtitle}" Style="{StaticResource PageSubtitleTextStyle}" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Top" Command="{x:Bind ViewModel.OpenBenchmarkCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE9D2;" FontSize="14" />
                        <TextBlock Text="{h:Str Key=Gaming_Action_Benchmark}" />
                    </StackPanel>
                </Button>
            </Grid>

            <InfoBar Severity="Error" h:InfoBarHelper.IsShown="{x:Bind ViewModel.HasError, Mode=OneWay}" Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                     Title="{h:Str Key=Common_Label_ErrorTitle}" CloseButtonCommand="{x:Bind ViewModel.DismissErrorCommand}" />
            <InfoBar Severity="Success" h:InfoBarHelper.IsShown="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}" Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                     CloseButtonCommand="{x:Bind ViewModel.DismissStatusCommand}" />

            <!-- Bande de session : seul aplat saturé de l'application (inactive comme active ; l'état est porté par le glyphe et le texte). -->
            <Border Style="{StaticResource SessionBandStyle}" Background="{ThemeResource SessionBandBrush}">
                <StackPanel Spacing="20">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.CurrentGameText, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="WrapWholeWords"
                                       Foreground="{ThemeResource SessionForegroundBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentGameSourceText, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource SessionSecondaryForegroundBrush}"
                                       Visibility="{x:Bind h:Ui.Show(ViewModel.HasCurrentGame), Mode=OneWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                <FontIcon Glyph="{x:Bind ViewModel.StateGlyph, Mode=OneWay}" FontSize="14" Foreground="{ThemeResource SessionForegroundBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.StateText, Mode=OneWay}" Foreground="{ThemeResource SessionForegroundBrush}" />
                            </StackPanel>
                            <ProgressBar IsIndeterminate="True" Margin="0,6,0,0" MaxWidth="320" HorizontalAlignment="Left" Foreground="{ThemeResource SessionForegroundBrush}"
                                         Visibility="{x:Bind h:Ui.Show(ViewModel.IsTransitioning), Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Top">
                            <Button Style="{StaticResource SessionButtonStyle}" Command="{x:Bind ViewModel.ActivateCommand}" HorizontalAlignment="Stretch"
                                    Visibility="{x:Bind h:Ui.Hide(ViewModel.IsModeActive), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7FC;" FontSize="16" />
                                    <TextBlock Text="{h:Str Key=Gaming_Action_Activate}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SessionSecondaryButtonStyle}" Content="{h:Str Key=Gaming_Action_Detect}" Command="{x:Bind ViewModel.DetectGameCommand}"
                                    HorizontalAlignment="Stretch" Visibility="{x:Bind h:Ui.Hide(ViewModel.IsModeActive), Mode=OneWay}" />
                            <Button Style="{StaticResource SessionButtonStyle}" Command="{x:Bind ViewModel.DeactivateCommand}" HorizontalAlignment="Stretch"
                                    Visibility="{x:Bind h:Ui.Show(ViewModel.IsModeActive), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7A7;" FontSize="16" />
                                    <TextBlock Text="{h:Str Key=Gaming_Action_Deactivate}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Images par seconde : uniquement lorsqu'elles sont réellement mesurées. -->
                    <Grid ColumnSpacing="28" RowSpacing="16" Visibility="{x:Bind h:Ui.Show(ViewModel.FpsTile.IsAvailable), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" AutomationProperties.Name="{x:Bind ViewModel.FpsTile.AccessibleName, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.FpsTile.Title}" FontSize="12" TextWrapping="WrapWholeWords" MaxLines="2" Foreground="{ThemeResource SessionSecondaryForegroundBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.FpsTile.Value, Mode=OneWay}" Style="{StaticResource SessionNumeralTextStyle}" FontSize="{x:Bind h:Ui.SessionNumeralSize(ViewModel.FpsTile.IsAvailable), Mode=OneWay}" TextWrapping="WrapWholeWords" TextTrimming="None" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2" AutomationProperties.Name="{x:Bind ViewModel.OnePercentLowTile.AccessibleName, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.OnePercentLowTile.Title}" FontSize="12" TextWrapping="WrapWholeWords" MaxLines="2" Foreground="{ThemeResource SessionSecondaryForegroundBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.OnePercentLowTile.Value, Mode=OneWay}" Style="{StaticResource SessionNumeralTextStyle}" FontSize="{x:Bind h:Ui.SessionNumeralSize(ViewModel.OnePercentLowTile.IsAvailable), Mode=OneWay}" TextWrapping="WrapWholeWords" TextTrimming="None" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2" AutomationProperties.Name="{x:Bind ViewModel.PointOnePercentLowTile.AccessibleName, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.PointOnePercentLowTile.Title}" FontSize="12" TextWrapping="WrapWholeWords" MaxLines="2" Foreground="{ThemeResource SessionSecondaryForegroundBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.PointOnePercentLowTile.Value, Mode=OneWay}" Style="{StaticResource SessionNumeralTextStyle}" FontSize="{x:Bind h:Ui.SessionNumeralSize(ViewModel.PointOnePercentLowTile.IsAvailable), Mode=OneWay}" TextWrapping="WrapWholeWords" TextTrimming="None" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="2" AutomationProperties.Name="{x:Bind ViewModel.FrameTimeTile.AccessibleName, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.FrameTimeTile.Title}" FontSize="12" TextWrapping="WrapWholeWords" MaxLines="2" Foreground="{ThemeResource SessionSecondaryForegroundBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.FrameTimeTile.Value, Mode=OneWay}" Style="{StaticResource SessionNumeralTextStyle}" FontSize="{x:Bind h:Ui.SessionNumeralSize(ViewModel.FrameTimeTile.IsAvailable), Mode=OneWay}" TextWrapping="WrapWholeWords" TextTrimming="None" />
                        </StackPanel>
                    </Grid>

                    <!-- Mesures de la session -->
                    <StackPanel Spacing="14" Visibility="{x:Bind h:Ui.Show(ViewModel.IsModeActive), Mode=OneWay}">
                        <Border BorderBrush="{ThemeResource SessionDividerBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                            <Grid ColumnSpacing="24" RowSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Grid.Column="0" Grid.Row="0" Spacing="2" AutomationProperties.Name="{x:Bind ViewModel.CpuTile.AccessibleName, Mode=OneWay}">
                                <TextBlock Text="{x:Bind ViewModel.CpuTile.Title}" FontSize="12" TextWrapping="WrapWholeWords" MaxLines="2" Foreground="{ThemeResource SessionSecondaryForegroundBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.CpuTile.Value, Mode=OneWay}" Style="{StaticResource SessionMetricTextStyle}" FontSize="{x:Bind h:Ui.MetricValueSize(ViewModel.CpuTile.IsAvailable), Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Grid.Row="0" Spacing="2" AutomationProperties.Name="{x:Bind ViewModel.GpuTile.AccessibleName, Mode=OneWay}">
                                <TextBlock Text="{x:Bind ViewModel.GpuTile.Title}" FontSize="12" TextWrapping="WrapWholeWords" MaxLines="2" Foreground="{ThemeResource SessionSecondaryForegroundBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.GpuTile.Value, Mode=OneWay}" Style="{StaticResource SessionMetricTextStyle}" FontSize="{x:Bind h:Ui.MetricValueSize(ViewModel.GpuTile.IsAvailable), Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Grid.Row="0" Spacing="2" AutomationProperties.Name="{x:Bind ViewModel.RamTile.AccessibleName, Mode=OneWay}">
                                <TextBlock Text="{x:Bind ViewModel.RamTile.Title}" FontSize="12" TextWrapping="WrapWholeWords" MaxLines="2" Foreground="{ThemeResource SessionSecondaryForegroundBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.RamTile.Value, Mode=OneWay}" Style="{StaticResource SessionMetricTextStyle}" FontSize="{x:Bind h:Ui.MetricValueSize(ViewModel.RamTile.IsAvailable), Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="0" Grid.Row="1" Spacing="2" AutomationProperties.Name="{x:Bind ViewModel.VramTile.AccessibleName, Mode=OneWay}">
                                <TextBlock Text="{x:Bind ViewModel.VramTile.Title}" FontSize="12" TextWrapping="WrapWholeWords" MaxLines="2" Foreground="{ThemeResource SessionSecondaryForegroundBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.VramTile.Value, Mode=OneWay}" Style="{StaticResource SessionMetricTextStyle}" FontSize="{x:Bind h:Ui.MetricValueSize(ViewModel.VramTile.IsAvailable), Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Grid.Row="1" Spacing="2" AutomationProperties.Name="{x:Bind ViewModel.CpuTemperatureTile.AccessibleName, Mode=OneWay}">
                                <TextBlock Text="{x:Bind ViewModel.CpuTemperatureTile.Title}" FontSize="12" TextWrapping="WrapWholeWords" MaxLines="2" Foreground="{ThemeResource SessionSecondaryForegroundBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.CpuTemperatureTile.Value, Mode=OneWay}" Style="{StaticResource SessionMetricTextStyle}" FontSize="{x:Bind h:Ui.MetricValueSize(ViewModel.CpuTemperatureTile.IsAvailable), Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Grid.Row="1" Spacing="2" AutomationProperties.Name="{x:Bind ViewModel.GpuTemperatureTile.AccessibleName, Mode=OneWay}">
                                <TextBlock Text="{x:Bind ViewModel.GpuTemperatureTile.Title}" FontSize="12" TextWrapping="WrapWholeWords" MaxLines="2" Foreground="{ThemeResource SessionSecondaryForegroundBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.GpuTemperatureTile.Value, Mode=OneWay}" Style="{StaticResource SessionMetricTextStyle}" FontSize="{x:Bind h:Ui.MetricValueSize(ViewModel.GpuTemperatureTile.IsAvailable), Mode=OneWay}" />
                            </StackPanel>
                            </Grid>
                        </Border>
                        <Grid ColumnSpacing="12" Visibility="{x:Bind h:Ui.Show(ViewModel.HasFrameCaptureNotice), Mode=OneWay}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE946;" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource SessionSecondaryForegroundBrush}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.FrameCaptureNotice, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Foreground="{ThemeResource SessionSecondaryForegroundBrush}" />
                            <Button Grid.Column="2" Style="{StaticResource SessionSecondaryButtonStyle}" Content="{h:Str Key=Gaming_Action_FpsSettings}"
                                    Command="{x:Bind ViewModel.OpenSettingsCommand}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
            <TextBlock Text="{x:Bind ViewModel.ResultText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" Visibility="{x:Bind h:Ui.ShowText(ViewModel.ResultText), Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.FrameCaptureNotice, Mode=OneWay}" Style="{StaticResource CaptionSecondaryTextStyle}"
                       Visibility="{x:Bind h:Ui.ShowAll(ViewModel.HasFrameCaptureNotice, ViewModel.IsInactive), Mode=OneWay}" />

            <!-- Optimisations + paramètres Windows -->
            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="12">
                    <TextBlock Text="{h:Str Key=Gaming_Planned_Header}" Style="{StaticResource SectionHeaderTextStyle}" Visibility="{x:Bind h:Ui.Hide(ViewModel.IsModeActive), Mode=OneWay}" />
                    <TextBlock Text="{h:Str Key=Gaming_Active_Header}" Style="{StaticResource SectionHeaderTextStyle}" Visibility="{x:Bind h:Ui.Show(ViewModel.IsModeActive), Mode=OneWay}" />
                    <Border Style="{StaticResource CardStyle}" Padding="20,8,20,8">
                        <StackPanel>
                            <TextBlock Text="{h:Str Key=Gaming_Planned_Description}" Style="{StaticResource CaptionSecondaryTextStyle}" Margin="0,6,0,4"
                                       Visibility="{x:Bind h:Ui.Hide(ViewModel.IsModeActive), Mode=OneWay}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.PlannedOptimizations}" IsTabStop="False" Visibility="{x:Bind h:Ui.Hide(ViewModel.IsModeActive), Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GamingOptimizationItemViewModel">
                                        <Grid ColumnSpacing="12" Padding="0,8,0,8" AutomationProperties.Name="{x:Bind AccessibleName}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="15" VerticalAlignment="Top" Margin="0,2,0,0" Foreground="{ThemeResource SessionAccentTextBrush}" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{x:Bind Label}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionSecondaryTextStyle}" Visibility="{x:Bind h:Ui.Show(HasDetail)}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.ActiveOptimizations}" IsTabStop="False" Visibility="{x:Bind h:Ui.Show(ViewModel.IsModeActive), Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GamingOptimizationItemViewModel">
                                        <Grid ColumnSpacing="12" Padding="0,8,0,8" AutomationProperties.Name="{x:Bind AccessibleName}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="15" VerticalAlignment="Top" Margin="0,2,0,0" Foreground="{ThemeResource SessionAccentTextBrush}" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{x:Bind Label}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionSecondaryTextStyle}" Visibility="{x:Bind h:Ui.Show(HasDetail)}" />
                                            </StackPanel>
                                            <controls:StatusBadge Grid.Column="2" Text="{x:Bind StatusText}" Kind="{x:Bind h:Ui.GoodOrNeutral(IsApplied)}" VerticalAlignment="Top" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{h:Str Key=Gaming_AutoActivation_Header}" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0" />
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{h:Str Key=Gaming_AutoActivation_Description}" Style="{StaticResource SecondaryTextStyle}" />
                            <RadioButtons ItemsSource="{x:Bind ViewModel.AutoActivationOptions}" SelectedIndex="{x:Bind ViewModel.AutoActivationIndex, Mode=TwoWay}"
                                          MaxColumns="3" AutomationProperties.Name="{h:Str Key=Gaming_AutoActivation_Header}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="12">
                    <TextBlock Text="{h:Str Key=Gaming_Checks_Header}" Style="{StaticResource SectionHeaderTextStyle}" />
                    <Border Style="{StaticResource CardStyle}" Padding="20,4,20,4">
                        <ItemsControl h:ListDividers.HideLast="True" ItemsSource="{x:Bind ViewModel.WindowsChecks}" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:GameSettingCheckItemViewModel">
                                    <StackPanel Spacing="4" Padding="0,12,0,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                                                AutomationProperties.Name="{x:Bind AccessibleName}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Label}" Style="{StaticResource GroupHeaderTextStyle}" TextWrapping="WrapWholeWords" />
                                            <controls:StatusBadge Grid.Column="1" Text="{x:Bind StatusText}" Glyph="{x:Bind IconGlyph}" Kind="{x:Bind h:Ui.GoodOrCaution(IsOk)}" VerticalAlignment="Top" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource SecondaryTextStyle}" />
                                        <HyperlinkButton Content="{x:Bind FixLabel}" Command="{x:Bind FixCommand}" Visibility="{x:Bind h:Ui.Show(CanFix)}" Padding="0,4,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Jeux installés -->
            <StackPanel Spacing="12">
                <Grid>
                    <StackPanel Spacing="2">
                        <TextBlock Text="{h:Str Key=Gaming_Games_Header}" Style="{StaticResource SectionHeaderTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.InstalledGamesText, Mode=OneWay}" Style="{StaticResource CaptionSecondaryTextStyle}" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}" Content="{h:Str Key=Gaming_Action_RefreshGames}" Command="{x:Bind ViewModel.RefreshGamesCommand}" />
                </Grid>
                <ProgressBar IsIndeterminate="True" Visibility="{x:Bind h:Ui.Show(ViewModel.IsLoadingGames), Mode=OneWay}" />
                <ItemsRepeater VerticalCacheLength="20" ItemsSource="{x:Bind ViewModel.InstalledGames}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="260" MinColumnSpacing="10" MinRowSpacing="10" ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:GameItemViewModel">
                            <Border Style="{StaticResource CardStyle}" Padding="16,12,16,12" ToolTipService.ToolTip="{x:Bind Location}" AutomationProperties.Name="{x:Bind AccessibleName}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource GroupHeaderTextStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind SourceText}" Style="{StaticResource CaptionSecondaryTextStyle}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</local:ViewPage>
