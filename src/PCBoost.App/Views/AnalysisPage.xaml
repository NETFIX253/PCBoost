<local:ViewPage
    x:Class="PCBoost.App.Views.AnalysisPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PCBoost.App.Views"
    xmlns:h="using:PCBoost.App.Helpers"
    xmlns:controls="using:PCBoost.App.Controls"
    xmlns:common="using:PCBoost.Presentation.Common"
    xmlns:vm="using:PCBoost.Presentation.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{StaticResource ContentMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="28">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock Text="{h:Str Key=Analysis_Title}" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Text="{h:Str Key=Analysis_Subtitle}" Style="{StaticResource PageSubtitleTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.AnalysisDateText, Mode=OneWay}" Style="{StaticResource CaptionSecondaryTextStyle}"
                               Visibility="{x:Bind h:Ui.Show(ViewModel.IsDone), Mode=OneWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="{h:Str Key=Analysis_Action_Start}" Command="{x:Bind ViewModel.StartAnalysisCommand}"
                            Visibility="{x:Bind h:Ui.Show(ViewModel.IsNotStarted), Mode=OneWay}" />
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="{h:Str Key=Analysis_Action_Restart}" Command="{x:Bind ViewModel.StartAnalysisCommand}"
                            Visibility="{x:Bind h:Ui.Show(ViewModel.IsDone), Mode=OneWay}" />
                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="{h:Str Key=Analysis_Action_Optimize}" Command="{x:Bind ViewModel.OptimizeCommand}"
                            Visibility="{x:Bind h:Ui.Show(ViewModel.IsDone), Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <InfoBar Severity="Error" h:InfoBarHelper.IsShown="{x:Bind ViewModel.HasError, Mode=OneWay}" Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                     Title="{h:Str Key=Common_Label_ErrorTitle}" CloseButtonCommand="{x:Bind ViewModel.DismissErrorCommand}" />

            <!-- Pas encore d'analyse -->
            <Border Style="{StaticResource CardStyle}" Padding="28,24,28,26" Visibility="{x:Bind h:Ui.Show(ViewModel.IsNotStarted), Mode=OneWay}">
                <StackPanel Spacing="10">
                    <FontIcon Glyph="&#xE9D9;" FontSize="28" HorizontalAlignment="Left" Foreground="{ThemeResource BrandAccentTextBrush}" />
                    <TextBlock Text="{h:Str Key=Analysis_NotStarted_Title}" Style="{StaticResource SectionHeaderTextStyle}" />
                    <TextBlock Text="{h:Str Key=Analysis_NotStarted_Message}" Style="{StaticResource SecondaryTextStyle}" />
                    <Button Style="{StaticResource HeroButtonStyle}" Margin="0,8,0,0" Content="{h:Str Key=Analysis_Action_Start}" Command="{x:Bind ViewModel.StartAnalysisCommand}" />
                </StackPanel>
            </Border>

            <!-- En cours -->
            <StackPanel Spacing="12" Visibility="{x:Bind h:Ui.Show(ViewModel.IsAnalyzing), Mode=OneWay}">
                <controls:ProgressCard Title="{h:Str Key=Analysis_Analyzing_Title}" Percent="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                                       CurrentText="{x:Bind ViewModel.CurrentStepText, Mode=OneWay}" Steps="{x:Bind ViewModel.Steps}" />
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="{h:Str Key=Common_Action_Cancel}" Command="{x:Bind ViewModel.StartAnalysisCancelCommand}" />
            </StackPanel>

            <!-- Résultats -->
            <StackPanel Spacing="28" Visibility="{x:Bind h:Ui.Show(ViewModel.IsDone), Mode=OneWay}">

                <!-- Constats (cartes par catégorie, §62) -->
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="{h:Str Key=Analysis_Section_Findings}" Style="{StaticResource SectionHeaderTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.FindingSummaryText, Mode=OneWay}" Style="{StaticResource CaptionSecondaryTextStyle}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <ItemsRepeater VerticalCacheLength="20" ItemsSource="{x:Bind ViewModel.ActiveFindingCards}">
                        <ItemsRepeater.Layout>
                            <!-- Nombre de constats variable d'une catégorie à l'autre : chaque rangée prend la hauteur de sa carte la plus haute. -->
                            <controls:CardGridLayout MinItemWidth="320" ColumnSpacing="12" RowSpacing="12" MaximumColumns="{x:Bind ViewModel.FindingColumns, Mode=OneWay}" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:FindingCardViewModel">
                                <Border Style="{StaticResource CardStyle}" AutomationProperties.Name="{x:Bind AccessibleName}">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Title}" Style="{StaticResource GroupHeaderTextStyle}" VerticalAlignment="Center" />
                                        </Grid>
                                        <controls:StatusBadge Text="{x:Bind StatusText}" Kind="{x:Bind h:Ui.SeverityKind(WorstSeverity)}" />
                                        <ItemsControl ItemsSource="{x:Bind Findings}" IsTabStop="False" Visibility="{x:Bind h:Ui.Show(HasFindings)}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:FindingItemViewModel">
                                                    <StackPanel Spacing="2" Padding="0,6,0,6" AutomationProperties.Name="{x:Bind AccessibleName}">
                                                        <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionSecondaryTextStyle}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{x:Bind EmptyText}" Style="{StaticResource CaptionSecondaryTextStyle}" Visibility="{x:Bind h:Ui.Hide(HasFindings)}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <Border Style="{StaticResource CardStyle}" Padding="20,14,20,14" Visibility="{x:Bind h:Ui.Show(ViewModel.HasCleanCategories), Mode=OneWay}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE73E;" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CleanCategoriesText, Mode=OneWay}" TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                    <HyperlinkButton Content="{h:Str Key=Analysis_Action_Diagnosis}" Command="{x:Bind ViewModel.OpenDiagnosisCommand}" Padding="0,4,0,4" />
                </StackPanel>

                <!-- Recommandations -->
                <StackPanel Spacing="12">
                    <TextBlock Text="{h:Str Key=Analysis_Section_Recommendations}" Style="{StaticResource SectionHeaderTextStyle}" />
                    <Border Style="{StaticResource CardStyle}" Padding="20,4,20,4">
                        <StackPanel>
                            <ItemsControl h:ListDividers.HideLast="True" ItemsSource="{x:Bind ViewModel.Recommendations}" IsTabStop="False" Visibility="{x:Bind h:Ui.Show(ViewModel.HasRecommendations), Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RecommendationItemViewModel">
                                        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                            <controls:RecommendationCard Item="{x:Bind}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{h:Str Key=Analysis_Recommendations_Empty}" Style="{StaticResource SecondaryTextStyle}" Padding="0,16,0,16"
                                       Visibility="{x:Bind h:Ui.Hide(ViewModel.HasRecommendations), Mode=OneWay}" />
                            <Grid Padding="0,10,0,12" Visibility="{x:Bind h:Ui.Show(ViewModel.HasDismissedRecommendations), Mode=OneWay}">
                                <TextBlock Text="{x:Bind ViewModel.DismissedRecommendationsText, Mode=OneWay}" Style="{StaticResource CaptionSecondaryTextStyle}" VerticalAlignment="Center" />
                                <HyperlinkButton HorizontalAlignment="Right" Content="{h:Str Key=Analysis_Action_ManageDismissed}" Command="{x:Bind ViewModel.OpenSettingsCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Matériel -->
                <Grid x:Name="DetailsGrid" ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                    <StackPanel Spacing="12">
                        <TextBlock Text="{h:Str Key=Analysis_Section_Hardware}" Style="{StaticResource SectionHeaderTextStyle}" />
                        <Border Style="{StaticResource CardStyle}" Padding="20,8,20,8">
                            <StackPanel>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.HardwareRows}" IsTabStop="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="common:InfoRowViewModel"><controls:InfoRowView Row="{x:Bind}" LabelWidth="150" /></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{h:Str Key=Analysis_Section_Gpu}" Style="{StaticResource GroupHeaderTextStyle}" Margin="0,12,0,0" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.GpuRows}" IsTabStop="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="common:InfoRowViewModel"><controls:InfoRowView Row="{x:Bind}" LabelWidth="150" /></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{h:Str Key=Analysis_Section_Temperatures}" Style="{StaticResource GroupHeaderTextStyle}" Margin="0,12,0,0" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.TemperatureRows}" IsTabStop="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="common:InfoRowViewModel"><controls:InfoRowView Row="{x:Bind}" LabelWidth="150" /></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="SoftwareBlock" Grid.Column="1" Spacing="12">
                        <TextBlock Text="{h:Str Key=Analysis_Section_Software}" Style="{StaticResource SectionHeaderTextStyle}" />
                        <Border Style="{StaticResource CardStyle}" Padding="20,8,20,12">
                            <StackPanel>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SoftwareRows}" IsTabStop="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="common:InfoRowViewModel"><controls:InfoRowView Row="{x:Bind}" LabelWidth="170" /></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{h:Str Key=Analysis_Section_TopMemory}" Style="{StaticResource GroupHeaderTextStyle}" Margin="0,12,0,4" Visibility="{x:Bind h:Ui.ShowCount(ViewModel.TopMemoryProcesses.Count), Mode=OneWay}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.TopMemoryProcesses}" IsTabStop="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ProcessUsageItemViewModel">
                                            <Grid Padding="0,4,0,4" ToolTipService.ToolTip="{x:Bind Path}">
                                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" Margin="0,0,80,0" />
                                                <TextBlock Text="{x:Bind Value}" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{h:Str Key=Analysis_Section_TopCpu}" Style="{StaticResource GroupHeaderTextStyle}" Margin="0,12,0,4" Visibility="{x:Bind h:Ui.ShowCount(ViewModel.TopCpuProcesses.Count), Mode=OneWay}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.TopCpuProcesses}" IsTabStop="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ProcessUsageItemViewModel">
                                            <Grid Padding="0,4,0,4" ToolTipService.ToolTip="{x:Bind Path}">
                                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" Margin="0,0,80,0" />
                                                <TextBlock Text="{x:Bind Value}" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Stockage -->
                    <StackPanel Grid.Row="1" Spacing="12">
                        <Grid>
                            <TextBlock Text="{h:Str Key=Analysis_Section_Storage}" Style="{StaticResource SectionHeaderTextStyle}" />
                            <HyperlinkButton HorizontalAlignment="Right" Content="{h:Str Key=Analysis_Action_Storage}" Command="{x:Bind ViewModel.OpenStorageCommand}" />
                        </Grid>
                        <Border Style="{StaticResource CardStyle}" Padding="20,8,20,8">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Drives}" IsTabStop="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DriveItemViewModel">
                                        <StackPanel Spacing="6" Padding="0,10,0,10" AutomationProperties.Name="{x:Bind AccessibleName}">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource GroupHeaderTextStyle}" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                    <controls:StatusBadge Text="{x:Bind SystemBadge}" Kind="Accent" Visibility="{x:Bind h:Ui.Show(IsSystemDrive)}" />
                                                    <controls:StatusBadge Text="{x:Bind TypeText}" />
                                                    <controls:StatusBadge Text="{x:Bind BusText}" Visibility="{x:Bind h:Ui.Show(HasBus)}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{x:Bind FreeText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                            <ProgressBar Style="{StaticResource PointsBarStyle}" Value="{x:Bind UsedPercent}" AutomationProperties.AccessibilityView="Raw" />
                                            <TextBlock Text="{x:Bind Model}" Style="{StaticResource CaptionSecondaryTextStyle}" Visibility="{x:Bind h:Ui.ShowText(Model)}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <!-- Profil matériel et conseils -->
                    <StackPanel x:Name="AdviceBlock" Grid.Row="1" Grid.Column="1" Spacing="12">
                        <TextBlock Text="{h:Str Key=Analysis_Section_Profile}" Style="{StaticResource SectionHeaderTextStyle}" />
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{x:Bind ViewModel.HardwareTierText, Mode=OneWay}" Style="{StaticResource GroupHeaderTextStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.HardwareTierDescription, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.HardwareProfileReasons}" IsTabStop="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="common:TextItemViewModel">
                                            <Grid ColumnSpacing="8" Padding="0,2,0,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <FontIcon Glyph="&#xE76C;" FontSize="10" VerticalAlignment="Top" Margin="0,5,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Text}" Style="{StaticResource CaptionSecondaryTextStyle}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Style="{StaticResource RowDividerStyle}" Padding="0,12,0,0">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{h:Str Key=Analysis_Section_Advice}" Style="{StaticResource GroupHeaderTextStyle}" />
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.HardwareAdvice}" IsTabStop="False" Visibility="{x:Bind h:Ui.Show(ViewModel.HasHardwareAdvice), Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:HardwareAdviceItemViewModel">
                                                    <StackPanel Spacing="3" Padding="0,6,0,6">
                                                        <TextBlock Text="{x:Bind Observation}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{x:Bind Suggestion}" Style="{StaticResource SecondaryTextStyle}" />
                                                        <TextBlock Text="{x:Bind ConfidenceText}" Style="{StaticResource CaptionSecondaryTextStyle}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{h:Str Key=Analysis_Advice_Empty}" Style="{StaticResource SecondaryTextStyle}" Visibility="{x:Bind h:Ui.Hide(ViewModel.HasHardwareAdvice), Mode=OneWay}" />
                                        <TextBlock Text="{h:Str Key=Analysis_Advice_Disclaimer}" Style="{StaticResource CaptionSecondaryTextStyle}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</local:ViewPage>
