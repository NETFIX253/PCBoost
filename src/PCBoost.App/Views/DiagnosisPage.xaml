<local:ViewPage
    x:Class="PCBoost.App.Views.DiagnosisPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PCBoost.App.Views"
    xmlns:h="using:PCBoost.App.Helpers"
    xmlns:controls="using:PCBoost.App.Controls"
    xmlns:vm="using:PCBoost.Presentation.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="880" Padding="{StaticResource PagePadding}" Spacing="24" HorizontalAlignment="Left">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock Text="{h:Str Key=Diagnosis_Title}" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.DiagnosisDateText, Mode=OneWay}" Style="{StaticResource CaptionSecondaryTextStyle}"
                               Visibility="{x:Bind h:Ui.Show(ViewModel.HasResult), Mode=OneWay}" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Top" Content="{h:Str Key=Diagnosis_Action_Refresh}"
                        Command="{x:Bind ViewModel.DiagnoseCommand}" Visibility="{x:Bind h:Ui.Hide(ViewModel.IsDiagnosing), Mode=OneWay}" />
            </Grid>

            <InfoBar Severity="Error" h:InfoBarHelper.IsShown="{x:Bind ViewModel.HasError, Mode=OneWay}" Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                     Title="{h:Str Key=Common_Label_ErrorTitle}" CloseButtonCommand="{x:Bind ViewModel.DismissErrorCommand}" />

            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind h:Ui.Show(ViewModel.IsDiagnosing), Mode=OneWay}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{h:Str Key=Diagnosis_Diagnosing}" Style="{StaticResource SectionHeaderTextStyle}" />
                    <ProgressBar IsIndeterminate="True" AutomationProperties.Name="{h:Str Key=Diagnosis_Diagnosing}" />
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="{h:Str Key=Common_Action_Cancel}" Command="{x:Bind ViewModel.DiagnoseCancelCommand}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="24,20,24,22" Visibility="{x:Bind h:Ui.Show(ViewModel.ShowNoFactor), Mode=OneWay}">
                <StackPanel Spacing="8">
                    <FontIcon Glyph="&#xE73E;" FontSize="24" HorizontalAlignment="Left" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    <TextBlock Text="{h:Str Key=Diagnosis_NoFactor_Title}" Style="{StaticResource SectionHeaderTextStyle}" />
                    <TextBlock Text="{h:Str Key=Diagnosis_NoFactor_Message}" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
            </Border>

            <StackPanel Spacing="14" Visibility="{x:Bind h:Ui.Show(ViewModel.ShowFactors), Mode=OneWay}">
                <TextBlock Text="{h:Str Key=Diagnosis_Intro}" Style="{StaticResource SectionHeaderTextStyle}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Factors}" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SlownessFactorItemViewModel">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="22,18,22,18" AutomationProperties.Name="{x:Bind AccessibleName}">
                                <StackPanel Spacing="10">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="18" Background="{ThemeResource BrandAccentSubtleBrush}" VerticalAlignment="Top">
                                            <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="16" Foreground="{ThemeResource BrandAccentTextBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource GroupHeaderTextStyle}" FontSize="16" />
                                            <TextBlock Text="{x:Bind Evidence}" Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Right">
                                            <TextBlock Text="{h:Str Key=Diagnosis_Impact}" Style="{StaticResource FieldLabelTextStyle}" HorizontalAlignment="Right" />
                                            <TextBlock Text="{x:Bind ImpactText}" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Right" />
                                            <TextBlock Text="{x:Bind ConfidenceText}" Style="{StaticResource CaptionSecondaryTextStyle}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnSpacing="24" Margin="50,4,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{h:Str Key=Diagnosis_Why}" Style="{StaticResource FieldLabelTextStyle}" />
                                            <TextBlock Text="{x:Bind Why}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="{h:Str Key=Diagnosis_WhatToDo}" Style="{StaticResource FieldLabelTextStyle}" />
                                            <TextBlock Text="{x:Bind WhatToDo}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Margin="50,4,0,0" Content="{x:Bind ActionLabel}" Command="{x:Bind OpenCommand}"
                                            Visibility="{x:Bind h:Ui.Show(HasAction)}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</local:ViewPage>
