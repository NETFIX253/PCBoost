<local:ViewPage
    x:Class="PCBoost.App.Views.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PCBoost.App.Views"
    xmlns:h="using:PCBoost.App.Helpers"
    xmlns:controls="using:PCBoost.App.Controls"
    xmlns:vm="using:PCBoost.Presentation.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{StaticResource ContentMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="20">
            <StackPanel Spacing="6">
                <TextBlock Text="{h:Str Key=Startup_Title}" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="{h:Str Key=Startup_Subtitle}" Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>

            <InfoBar Severity="Error" h:InfoBarHelper.IsShown="{x:Bind ViewModel.HasError, Mode=OneWay}" Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                     Title="{h:Str Key=Common_Label_ErrorTitle}" CloseButtonCommand="{x:Bind ViewModel.DismissErrorCommand}" />
            <InfoBar Severity="Success" h:InfoBarHelper.IsShown="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}" Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                     CloseButtonCommand="{x:Bind ViewModel.DismissStatusCommand}" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <AutoSuggestBox PlaceholderText="{h:Str Key=Startup_Search_Placeholder}" QueryIcon="Find" MaxWidth="360" HorizontalAlignment="Left"
                                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" AutomationProperties.Name="{h:Str Key=Startup_Search_Placeholder}" />
                <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.Filters}" SelectedIndex="{x:Bind ViewModel.SelectedFilterIndex, Mode=TwoWay}"
                          MinWidth="200" AutomationProperties.Name="{h:Str Key=Startup_Filter_Label}" />
                <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Command="{x:Bind ViewModel.RefreshCommand}"
                        ToolTipService.ToolTip="{h:Str Key=Common_Action_Refresh}" AutomationProperties.Name="{h:Str Key=Common_Action_Refresh}">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </Grid>
            <TextBlock Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" Style="{StaticResource CaptionSecondaryTextStyle}" Margin="0,-8,0,0" />

            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind h:Ui.Hide(ViewModel.IsLoaded), Mode=OneWay}" />

            <Border Style="{StaticResource SubtleSurfaceStyle}" Visibility="{x:Bind h:Ui.Show(ViewModel.ShowEmpty), Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" TextWrapping="Wrap" />
            </Border>

            <ItemsControl ItemsSource="{x:Bind ViewModel.Items}" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StartupItemViewModel">
                        <Grid Margin="0,0,0,8">
                            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{x:Bind AccessibleName}">
                                <Expander.Header>
                                    <Grid ColumnSpacing="16" Padding="0,10,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource GroupHeaderTextStyle}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource CaptionSecondaryTextStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                                <Run Text="{x:Bind PublisherText}" /><Run Text="  ·  " /><Run Text="{x:Bind ImpactText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <controls:StatusBadge Text="{x:Bind RecommendationText, Mode=OneWay}" Glyph="{x:Bind RecommendationGlyph, Mode=OneWay}"
                                                                  Kind="{x:Bind h:Ui.AccentOrNeutral(IsRecommendedToDisable), Mode=OneWay}" />
                                            <controls:StatusBadge Text="{h:Str Key=Startup_Badge_Locked}" Glyph="&#xE72E;" Kind="Neutral"
                                                                  Visibility="{x:Bind h:Ui.Show(IsLocked), Mode=OneWay}" ToolTipService.ToolTip="{x:Bind SecurityNotice}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center" MinWidth="116">
                                            <ToggleSwitch IsOn="{x:Bind IsEnabled, Mode=TwoWay}" IsEnabled="{x:Bind CanToggle, Mode=OneWay}"
                                                          OnContent="{x:Bind StateText, Mode=OneWay}" OffContent="{x:Bind StateText, Mode=OneWay}"
                                                          AutomationProperties.Name="{h:Str Key=Startup_Toggle_AccessibleName}"
                                                          AutomationProperties.HelpText="{x:Bind ToggleHelpText, Mode=OneWay}" />
                                            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind h:Ui.Show(IsToggling), Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                </Expander.Header>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind RecommendationReason, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind h:Ui.ShowText(RecommendationReason), Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind SecurityNotice}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                               Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind h:Ui.Show(IsSecuritySoftware)}" />
                                    <TextBlock Text="{x:Bind MissingExecutableText}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                               Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind h:Ui.Show(IsMissingExecutable)}" />
                                    <Grid ColumnSpacing="16" RowSpacing="6" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock Text="{h:Str Key=Startup_Detail_Evidence}" Style="{StaticResource SecondaryTextStyle}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind EvidenceText, Mode=OneWay}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="1" Text="{h:Str Key=Startup_Detail_Location}" Style="{StaticResource SecondaryTextStyle}" />
                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{x:Bind LocationText}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind SourcePath}" Style="{StaticResource CaptionSecondaryTextStyle}" IsTextSelectionEnabled="True" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="2" Text="{h:Str Key=Startup_Detail_Command}" Style="{StaticResource SecondaryTextStyle}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind CommandText}" Style="{StaticResource MonospaceDataTextStyle}" />
                                        <TextBlock Grid.Row="3" Text="{h:Str Key=Startup_Detail_Signature}" Style="{StaticResource SecondaryTextStyle}" />
                                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind SignatureText}" TextWrapping="Wrap" />
                                            <controls:StatusBadge Text="{x:Bind AdminBadgeText}" Glyph="&#xE7EF;" Kind="Info" Visibility="{x:Bind h:Ui.Show(RequiresElevation)}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Expander>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <HyperlinkButton Content="{h:Str Key=Startup_Action_History}" Command="{x:Bind ViewModel.OpenHistoryCommand}" />
        </StackPanel>
    </ScrollViewer>
</local:ViewPage>
