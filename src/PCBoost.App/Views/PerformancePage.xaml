<local:ViewPage
    x:Class="PCBoost.App.Views.PerformancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PCBoost.App.Views"
    xmlns:h="using:PCBoost.App.Helpers"
    xmlns:controls="using:PCBoost.App.Controls"
    xmlns:vm="using:PCBoost.Presentation.ViewModels">

    <local:ViewPage.Resources>
        <DataTemplate x:Key="SeriesTemplate" x:DataType="vm:MetricSeriesViewModel">
            <Border Style="{StaticResource CardStyle}" Padding="20,16,20,14" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="0">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource GroupHeaderTextStyle}" />
                            <TextBlock Text="{x:Bind CurrentText, Mode=OneWay}" Style="{StaticResource MetricValueTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource CaptionSecondaryTextStyle}">
                                <Run Text="{h:Str Key=Performance_Average}" /><Run Text=" " /><Run Text="{x:Bind AverageText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource CaptionSecondaryTextStyle}">
                                <Run Text="{h:Str Key=Performance_Maximum}" /><Run Text=" " /><Run Text="{x:Bind MaximumText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                    <Grid Height="104">
                        <controls:PerformanceChart Values="{x:Bind Points, Mode=OneWay}" AccessibleText="{x:Bind AccessibleName, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind UnavailableReason, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" Visibility="{x:Bind h:Ui.ShowText(UnavailableReason), Mode=OneWay}" />
                    </Grid>
                    <TextBlock Text="{x:Bind ScaleText, Mode=OneWay}" Style="{StaticResource CaptionSecondaryTextStyle}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </local:ViewPage.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{StaticResource ContentMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="20">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock Text="{h:Str Key=Performance_Title}" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Text="{h:Str Key=Performance_Subtitle}" Style="{StaticResource PageSubtitleTextStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Top">
                    <ComboBox ItemsSource="{x:Bind ViewModel.Periods}" SelectedIndex="{x:Bind ViewModel.SelectedPeriodIndex, Mode=TwoWay}" MinWidth="200"
                              AutomationProperties.Name="{h:Str Key=Performance_Period_Label}" />
                    <TextBlock Text="{x:Bind ViewModel.IntervalText, Mode=OneWay}" Style="{StaticResource CaptionSecondaryTextStyle}" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>

            <InfoBar Severity="Warning" h:InfoBarHelper.IsShown="{x:Bind ViewModel.IsMonitoringPaused, Mode=OneWay}" IsClosable="False" Message="{h:Str Key=Performance_Paused}" />
            <InfoBar Severity="Informational" h:InfoBarHelper.IsShown="{x:Bind ViewModel.HasNoHistory, Mode=OneWay}" IsClosable="False" Message="{h:Str Key=Performance_NoHistory}" />
            <InfoBar Severity="Error" h:InfoBarHelper.IsShown="{x:Bind ViewModel.HasError, Mode=OneWay}" Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                     Title="{h:Str Key=Common_Label_ErrorTitle}" CloseButtonCommand="{x:Bind ViewModel.DismissErrorCommand}" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{h:Str Key=Performance_Section_Usage}" Style="{StaticResource SectionHeaderTextStyle}" />
                <TextBlock Grid.Column="1" Style="{StaticResource CaptionSecondaryTextStyle}" VerticalAlignment="Bottom">
                    <Run Text="{x:Bind ViewModel.AxisStartText, Mode=OneWay}" /><Run Text="  →  " /><Run Text="{h:Str Key=Performance_AxisEnd}" />
                </TextBlock>
            </Grid>
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ContentControl Content="{x:Bind ViewModel.CpuSeries}" ContentTemplate="{StaticResource SeriesTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False" />
                <ContentControl Grid.Column="1" Content="{x:Bind ViewModel.MemorySeries}" ContentTemplate="{StaticResource SeriesTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False" />
                <ContentControl Grid.Row="1" Content="{x:Bind ViewModel.DiskSeries}" ContentTemplate="{StaticResource SeriesTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False" />
                <ContentControl Grid.Row="1" Grid.Column="1" Content="{x:Bind ViewModel.GpuSeries}" ContentTemplate="{StaticResource SeriesTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False" />
            </Grid>

            <TextBlock Text="{h:Str Key=Performance_Section_Network}" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <ContentControl Content="{x:Bind ViewModel.NetworkReceiveSeries}" ContentTemplate="{StaticResource SeriesTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False" />
                <ContentControl Grid.Column="1" Content="{x:Bind ViewModel.NetworkSendSeries}" ContentTemplate="{StaticResource SeriesTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False" />
            </Grid>

            <TextBlock Text="{h:Str Key=Performance_Section_Temperatures}" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <ContentControl Content="{x:Bind ViewModel.CpuTemperatureSeries}" ContentTemplate="{StaticResource SeriesTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False" />
                <ContentControl Grid.Column="1" Content="{x:Bind ViewModel.GpuTemperatureSeries}" ContentTemplate="{StaticResource SeriesTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</local:ViewPage>
