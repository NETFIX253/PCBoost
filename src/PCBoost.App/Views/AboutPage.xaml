<local:ViewPage
    x:Class="PCBoost.App.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PCBoost.App.Views"
    xmlns:h="using:PCBoost.App.Helpers"
    xmlns:controls="using:PCBoost.App.Controls"
    xmlns:common="using:PCBoost.Presentation.Common">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="880" Padding="{StaticResource PagePadding}" Spacing="24">
            <TextBlock Text="{h:Str Key=About_Title}" Style="{StaticResource PageTitleTextStyle}" />

            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Image Width="64" Height="64" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw">
                    <Image.Source>
                        <!-- Décodé à la taille affichée (mise à l'échelle comprise) : net à 100 % comme à 200 %. -->
                        <BitmapImage UriSource="ms-appx:///Assets/Branding/logo-256.png" DecodePixelWidth="64" DecodePixelType="Logical" />
                    </Image.Source>
                </Image>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.ProductName}" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.Slogan}" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.VersionText}" Style="{StaticResource CaptionSecondaryTextStyle}" IsTextSelectionEnabled="True" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{x:Bind ViewModel.Description}" Style="{StaticResource SecondaryTextStyle}" MaxWidth="720" HorizontalAlignment="Left" />

            <Border Style="{StaticResource CardStyle}" Padding="20,8,20,8">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Details}" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="common:InfoRowViewModel">
                            <controls:InfoRowView Row="{x:Bind}" LabelWidth="200" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="{h:Str Key=About_Action_Website}" Command="{x:Bind ViewModel.OpenWebsiteCommand}"
                        Visibility="{x:Bind h:Ui.Show(ViewModel.HasWebsite)}" />
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="{h:Str Key=About_Action_Support}" Command="{x:Bind ViewModel.OpenSupportCommand}"
                        Visibility="{x:Bind h:Ui.Show(ViewModel.HasSupport)}" />
            </StackPanel>

            <InfoBar Severity="Informational" IsOpen="True" IsClosable="False" Message="{h:Str Key=About_Honesty_Note}" />
        </StackPanel>
    </ScrollViewer>
</local:ViewPage>
