<local:ViewPage
    x:Class="PCBoost.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PCBoost.App.Views"
    xmlns:h="using:PCBoost.App.Helpers"
    xmlns:controls="using:PCBoost.App.Controls"
    xmlns:vm="using:PCBoost.Presentation.ViewModels">

    <Grid x:Name="LayoutRoot" SizeChanged="OnLayoutSizeChanged">
    <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="PageRoot" MaxWidth="{StaticResource ContentMaxWidth}" Padding="{StaticResource PagePadding}" RowSpacing="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{h:Str Key=App_Home_Heading}" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.LastAnalysisText, Mode=OneWay}" Style="{StaticResource CaptionSecondaryTextStyle}"
                           VerticalAlignment="Bottom" Margin="0,0,0,6" />
            </Grid>

            <!-- Score + détail du score -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="28,24,28,26">
                <Grid x:Name="HeroGrid" ColumnSpacing="40" RowSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="HeroLeftColumn" Width="5*" />
                        <ColumnDefinition x:Name="HeroRightColumn" Width="6*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Bloc score -->
                    <StackPanel x:Name="ScoreBlock" Spacing="10">
                        <TextBlock Text="{h:Str Key=Home_Score_Header}" Style="{StaticResource FieldLabelTextStyle}" />

                        <!-- État vide -->
                        <StackPanel Spacing="8" Visibility="{x:Bind h:Ui.Show(ViewModel.ShowEmptyState), Mode=OneWay}">
                            <TextBlock Text="{h:Str Key=Home_Empty_Title}" Style="{StaticResource SectionHeaderTextStyle}" />
                            <TextBlock Text="{h:Str Key=Home_Empty_Message}" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>

                        <!-- Analyse en cours -->
                        <StackPanel Spacing="10" Visibility="{x:Bind h:Ui.Show(ViewModel.IsAnalyzing), Mode=OneWay}">
                            <TextBlock Text="{h:Str Key=Home_Analyzing}" Style="{StaticResource SectionHeaderTextStyle}" />
                            <ProgressBar Value="{x:Bind ViewModel.AnalysisProgressPercent, Mode=OneWay}" Maximum="100"
                                         AutomationProperties.Name="{h:Str Key=Home_Analyzing}" />
                            <TextBlock Text="{x:Bind ViewModel.AnalysisStepText, Mode=OneWay}" Style="{StaticResource CaptionSecondaryTextStyle}" />
                        </StackPanel>

                        <!-- Score -->
                        <StackPanel Spacing="6" Visibility="{x:Bind h:Ui.Show(ViewModel.HasReport), Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind ViewModel.ScoreAccessibleName, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{x:Bind ViewModel.ScoreText, Mode=OneWay}" Style="{StaticResource ScoreNumeralTextStyle}" />
                                <TextBlock Text="{h:Str Key=App_Home_ScoreOutOf}" Style="{StaticResource SubtitleTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,12" />
                            </StackPanel>
                            <controls:StatusBadge Text="{x:Bind ViewModel.ScoreLevelText, Mode=OneWay}" Glyph="{x:Bind ViewModel.ScoreGlyph, Mode=OneWay}" Kind="Accent" />
                            <TextBlock Text="{x:Bind ViewModel.StatusSentence, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}"
                                       FontSize="16" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                            <Button Style="{StaticResource HeroButtonStyle}" Command="{x:Bind ViewModel.OptimizeCommand}"
                                    AutomationProperties.HelpText="{h:Str Key=App_Home_OptimizeHint}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE945;" FontSize="16" />
                                    <TextBlock Text="{h:Str Key=Welcome_Action_Optimize}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource HeroSecondaryButtonStyle}" Content="{h:Str Key=Home_Action_Analyze}"
                                    Command="{x:Bind ViewModel.AnalyzeCommand}" />
                        </StackPanel>
                        <TextBlock Text="{h:Str Key=App_Home_OptimizeHint}" Style="{StaticResource CaptionSecondaryTextStyle}" />
                        <HyperlinkButton Command="{x:Bind ViewModel.WhyIsMyPcSlowCommand}" Padding="0,4,0,4" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE9CE;" FontSize="14" />
                                <TextBlock Text="{h:Str Key=Home_WhySlow}" />
                            </StackPanel>
                        </HyperlinkButton>
                    </StackPanel>

                    <!-- Détail du score : chaque facteur explique ses points et mène à l'action -->
                    <StackPanel x:Name="LedgerBlock" Grid.Column="1" Spacing="6" Visibility="{x:Bind h:Ui.Show(ViewModel.HasReport), Mode=OneWay}">
                        <TextBlock Text="{h:Str Key=Home_Factors_Header}" Style="{StaticResource GroupHeaderTextStyle}" />
                        <TextBlock Text="{h:Str Key=Home_Score_Explanation}" Style="{StaticResource CaptionSecondaryTextStyle}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Factors, Mode=OneWay}" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ScoreFactorItemViewModel">
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="10,8,10,9" Margin="-10,0,-10,0"
                                            Background="Transparent" BorderThickness="0"
                                            Command="{x:Bind OpenCommand}"
                                            AutomationProperties.Name="{x:Bind AccessibleName}"
                                            ToolTipService.ToolTip="{x:Bind Explanation}">
                                        <Grid ColumnSpacing="12" RowSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="14" VerticalAlignment="Top" Margin="0,3,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Label}" TextWrapping="WrapWholeWords" />
                                            </Grid>
                                            <!-- Facteur au maximum : une seule ligne (le détail reste dans l'info-bulle et le nom accessible). -->
                                            <TextBlock Grid.Column="1" Text="{x:Bind StatusText}" FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind h:Ui.Show(IsGood)}" />
                                            <ProgressBar Grid.Column="2" Style="{StaticResource PointsBarStyle}" Value="{x:Bind Percent}"
                                                         AutomationProperties.AccessibilityView="Raw" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind PointsText}" HorizontalAlignment="Right" FontSize="13"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Typography.NumeralAlignment="Tabular" />
                                            <FontIcon Grid.Column="4" Glyph="&#xE76C;" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="8" Visibility="{x:Bind h:Ui.Hide(IsGood)}">
                                                <controls:StatusBadge Text="{x:Bind StatusText}" Kind="{x:Bind h:Ui.FactorKind(Status)}" />
                                                <TextBlock Text="{x:Bind Explanation}" Style="{StaticResource CaptionSecondaryTextStyle}"
                                                           VerticalAlignment="Center" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- En ce moment -->
            <StackPanel Grid.Row="2" Spacing="12">
                <TextBlock Text="{h:Str Key=Home_Live_Header}" Style="{StaticResource SectionHeaderTextStyle}" />
                <Grid x:Name="LiveGrid" ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:MetricCard Tile="{x:Bind ViewModel.CpuTile}" SecondaryTile="{x:Bind ViewModel.CpuTemperatureTile}" Glyph="&#xE950;" />
                    <controls:MetricCard Grid.Column="1" Tile="{x:Bind ViewModel.MemoryTile}" Glyph="&#xE964;" />
                    <controls:MetricCard Grid.Column="2" Tile="{x:Bind ViewModel.DiskTile}" Glyph="&#xEDA2;" />
                    <controls:MetricCard Grid.Column="3" Tile="{x:Bind ViewModel.GpuTile}" SecondaryTile="{x:Bind ViewModel.GpuTemperatureTile}" Glyph="&#xF211;" />
                </Grid>
                <TextBlock Text="{h:Str Key=Home_Temperatures_None}" Style="{StaticResource CaptionSecondaryTextStyle}"
                           Visibility="{x:Bind h:Ui.Hide(ViewModel.HasTemperatures), Mode=OneWay}" />
            </StackPanel>

            <!-- Recommandations principales -->
            <StackPanel Grid.Row="3" Spacing="12">
                <Grid>
                    <TextBlock Text="{h:Str Key=Home_Recommendations_Header}" Style="{StaticResource SectionHeaderTextStyle}" />
                    <HyperlinkButton HorizontalAlignment="Right" Content="{h:Str Key=Home_Recommendations_SeeAll}" Command="{x:Bind ViewModel.OpenAnalysisCommand}" />
                </Grid>
                <Border Style="{StaticResource CardStyle}" Padding="20,4,20,4">
                    <Grid>
                        <ItemsControl h:ListDividers.HideLast="True" ItemsSource="{x:Bind ViewModel.TopRecommendations, Mode=OneWay}" IsTabStop="False"
                                      Visibility="{x:Bind h:Ui.Show(ViewModel.HasRecommendations), Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecommendationItemViewModel">
                                    <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                        <controls:RecommendationCard Item="{x:Bind}" AllowDismiss="False" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,16,0,16"
                                    Visibility="{x:Bind h:Ui.Hide(ViewModel.HasRecommendations), Mode=OneWay}">
                            <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            <TextBlock Text="{h:Str Key=Home_Recommendations_Empty}" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Système + actions rapides -->
            <Grid x:Name="BottomGrid" Grid.Row="4" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="BottomLeftColumn" Width="3*" />
                    <ColumnDefinition x:Name="BottomRightColumn" Width="2*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="12">
                    <TextBlock Text="{h:Str Key=Home_System_Header}" Style="{StaticResource SectionHeaderTextStyle}" />
                    <Border Style="{StaticResource CardStyle}" Padding="20,4,20,4">
                        <StackPanel>
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                    Padding="0,12,0,12" Command="{x:Bind ViewModel.OpenStartupCommand}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE7B5;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{h:Str Key=Home_StartupApps_Label}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.StartupAppsText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </Grid>
                            </Button>
                            <Border Style="{StaticResource RowDividerStyle}" Padding="0">
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                        Padding="0,12,0,12" Command="{x:Bind ViewModel.OpenStorageCommand}">
                                    <Grid ColumnSpacing="12" RowSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <FontIcon Glyph="&#xEDA2;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{h:Str Key=Home_SystemDrive_Label}" />
                                            <TextBlock Text="{x:Bind ViewModel.SystemDriveDetail, Mode=OneWay}" Style="{StaticResource CaptionSecondaryTextStyle}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.SystemDriveFreeText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource PointsBarStyle}"
                                                     Value="{x:Bind ViewModel.SystemDriveUsedPercent, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw" />
                                    </Grid>
                                </Button>
                            </Border>
                            <Border Style="{StaticResource RowDividerStyle}" Padding="0">
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                        Padding="0,12,0,12" Command="{x:Bind ViewModel.OpenProcessesCommand}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE9F5;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{h:Str Key=Home_BackgroundProcesses_Label}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.BackgroundProcessesText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    </Grid>
                                </Button>
                            </Border>
                            <Border Style="{StaticResource RowDividerStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE770;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{h:Str Key=Home_Windows_Label}" />
                                        <TextBlock Text="{x:Bind ViewModel.WindowsVersionText, Mode=OneWay}" Style="{StaticResource CaptionSecondaryTextStyle}" />
                                        <TextBlock Text="{h:Str Key=Home_Windows_Unsupported}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                   Visibility="{x:Bind h:Ui.Show(ViewModel.IsWindowsUnsupported), Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Right">
                                        <TextBlock Text="{x:Bind ViewModel.WindowsEditionText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Right" />
                                        <TextBlock Text="{x:Bind ViewModel.UptimeText, Mode=OneWay}" Style="{StaticResource CaptionSecondaryTextStyle}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="QuickActionsBlock" Grid.Column="1" Spacing="12">
                    <TextBlock Text="{h:Str Key=Home_QuickActions_Header}" Style="{StaticResource SectionHeaderTextStyle}" />
                    <Border Style="{StaticResource CardStyle}" Padding="12">
                        <StackPanel Spacing="2">
                            <Button Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="10,10,10,10" Command="{x:Bind ViewModel.OptimizeCommand}">
                                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon Glyph="&#xE945;" FontSize="16" /><TextBlock Grid.Column="1" Text="{h:Str Key=Home_Action_Optimize}" /><FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></Grid>
                            </Button>
                            <Button Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="10,10,10,10" Command="{x:Bind ViewModel.CleanupCommand}">
                                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon Glyph="&#xEA99;" FontSize="16" /><TextBlock Grid.Column="1" Text="{h:Str Key=Home_Action_Cleanup}" /><FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></Grid>
                            </Button>
                            <Button Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="10,10,10,10" Command="{x:Bind ViewModel.OpenGamingCommand}">
                                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon Glyph="&#xE7FC;" FontSize="16" /><TextBlock Grid.Column="1" Text="{h:Str Key=Home_Action_Gaming}" /><FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></Grid>
                            </Button>
                            <Button Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="10,10,10,10" Command="{x:Bind ViewModel.AnalyzeCommand}">
                                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon Glyph="&#xE9D9;" FontSize="16" /><TextBlock Grid.Column="1" Text="{h:Str Key=Home_Action_Analyze}" /><FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></Grid>
                            </Button>
                            <Button Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="10,10,10,10" Command="{x:Bind ViewModel.OpenPerformanceCommand}">
                                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon Glyph="&#xE9D2;" FontSize="16" /><TextBlock Grid.Column="1" Text="{h:Str Key=Home_Action_Performance}" /><FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></Grid>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Erreur éventuelle -->
            <InfoBar Grid.Row="5" Severity="Error" h:InfoBarHelper.IsShown="{x:Bind ViewModel.HasError, Mode=OneWay}" Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                     Title="{h:Str Key=Common_Label_ErrorTitle}" IsClosable="False" />
        </Grid>

    </ScrollViewer>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <!-- États choisis selon la largeur de la zone de contenu (volet de navigation exclu), voir HomePage.xaml.cs. -->
                <VisualState x:Name="Wide" />
                <VisualState x:Name="Narrow">
                    <VisualState.Setters>
                        <Setter Target="HeroRightColumn.Width" Value="0" />
                        <Setter Target="HeroLeftColumn.Width" Value="*" />
                        <Setter Target="LedgerBlock.(Grid.Column)" Value="0" />
                        <Setter Target="LedgerBlock.(Grid.Row)" Value="1" />
                        <Setter Target="BottomRightColumn.Width" Value="0" />
                        <Setter Target="BottomLeftColumn.Width" Value="*" />
                        <Setter Target="QuickActionsBlock.(Grid.Column)" Value="0" />
                        <Setter Target="QuickActionsBlock.(Grid.Row)" Value="1" />
                        <Setter Target="HeroGrid.ColumnSpacing" Value="0" />
                        <Setter Target="BottomGrid.ColumnSpacing" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</local:ViewPage>
