<local:ViewPage
    x:Class="PCBoost.App.Views.ProcessesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PCBoost.App.Views"
    xmlns:h="using:PCBoost.App.Helpers"
    xmlns:controls="using:PCBoost.App.Controls"
    xmlns:vm="using:PCBoost.Presentation.ViewModels">

    <Grid MaxWidth="1320" Padding="{StaticResource PagePadding}" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock Text="{h:Str Key=Processes_Title}" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="{h:Str Key=Processes_Subtitle}" Style="{StaticResource PageSubtitleTextStyle}" />
            <TextBlock Text="{h:Str Key=Processes_Hint_Select}" Style="{StaticResource CaptionSecondaryTextStyle}" Visibility="{x:Bind h:Ui.Hide(ViewModel.HasSelection), Mode=OneWay}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar Severity="Error" h:InfoBarHelper.IsShown="{x:Bind ViewModel.HasError, Mode=OneWay}" Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                     Title="{h:Str Key=Common_Label_ErrorTitle}" CloseButtonCommand="{x:Bind ViewModel.DismissErrorCommand}" />
            <InfoBar Severity="Success" h:InfoBarHelper.IsShown="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}" Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                     CloseButtonCommand="{x:Bind ViewModel.DismissStatusCommand}" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <AutoSuggestBox PlaceholderText="{h:Str Key=Processes_Search_Placeholder}" QueryIcon="Find" MaxWidth="360" HorizontalAlignment="Left"
                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" AutomationProperties.Name="{h:Str Key=Processes_Search_Placeholder}" />
            <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.CountText, Mode=OneWay}" Style="{StaticResource CaptionSecondaryTextStyle}" HorizontalAlignment="Right" />
                <TextBlock Text="{h:Str Key=Processes_AutoRefresh}" Style="{StaticResource CaptionSecondaryTextStyle}" HorizontalAlignment="Right"
                           Visibility="{x:Bind h:Ui.Hide(ViewModel.IsActionInProgress), Mode=OneWay}" />
                <TextBlock Text="{h:Str Key=Processes_Paused}" Style="{StaticResource CaptionSecondaryTextStyle}" HorizontalAlignment="Right"
                           Visibility="{x:Bind h:Ui.Show(ViewModel.IsActionInProgress), Mode=OneWay}" />
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Command="{x:Bind ViewModel.RefreshCommand}"
                    ToolTipService.ToolTip="{h:Str Key=Common_Action_Refresh}" AutomationProperties.Name="{h:Str Key=Common_Action_Refresh}">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
        </Grid>

        <Grid x:Name="MainArea" Grid.Row="3" ColumnSpacing="0" SizeChanged="OnMainAreaSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="DetailColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- Liste -->
            <Border Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Padding="12,6,20,6" ColumnSpacing="8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="120" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource QuietButtonStyle}" Padding="4" HorizontalAlignment="Left" Content="{h:Str Key=Processes_Column_Name}"
                                Command="{x:Bind ViewModel.SortCommand}" CommandParameter="Name" ToolTipService.ToolTip="{h:Str Key=Processes_Sort_ToolTip}" />
                        <Button Grid.Column="1" Style="{StaticResource QuietButtonStyle}" Padding="4" HorizontalAlignment="Right" Content="{h:Str Key=Processes_Column_Cpu}"
                                Command="{x:Bind ViewModel.SortCommand}" CommandParameter="Cpu" ToolTipService.ToolTip="{h:Str Key=Processes_Sort_ToolTip}" />
                        <Button Grid.Column="2" Style="{StaticResource QuietButtonStyle}" Padding="4" HorizontalAlignment="Right" Content="{h:Str Key=Processes_Column_Memory}"
                                Command="{x:Bind ViewModel.SortCommand}" CommandParameter="Memory" ToolTipService.ToolTip="{h:Str Key=Processes_Sort_ToolTip}" />
                        <Button Grid.Column="3" Style="{StaticResource QuietButtonStyle}" Padding="4" HorizontalAlignment="Right" Content="{h:Str Key=Processes_Column_Disk}"
                                Command="{x:Bind ViewModel.SortCommand}" CommandParameter="Disk" ToolTipService.ToolTip="{h:Str Key=Processes_Sort_ToolTip}" />
                    </Grid>
                    <ListView x:Name="ProcessList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Items}" SelectionMode="Single"
                              ItemContainerStyle="{StaticResource StretchListViewItemStyle}" SelectionChanged="OnSelectionChanged"
                              AutomationProperties.Name="{h:Str Key=Processes_Title}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProcessItemViewModel">
                                <Grid ColumnSpacing="8" Padding="0,4,8,4" MinHeight="44" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="120" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="0" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind DisplayDescription, Mode=OneWay}" Style="{StaticResource CaptionSecondaryTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                       Visibility="{x:Bind h:Ui.ShowText(DisplayDescription), Mode=OneWay}" />
                                        </StackPanel>
                                        <controls:StatusBadge Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind ProtectionBadgeText, Mode=OneWay}" Glyph="{x:Bind ProtectionGlyph, Mode=OneWay}"
                                                              ToolTipService.ToolTip="{x:Bind ProtectionText, Mode=OneWay}" Visibility="{x:Bind h:Ui.Show(HasProtectionBadge), Mode=OneWay}" />
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{x:Bind CpuText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind MemoryText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind DiskText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <ProgressBar Grid.Row="1" IsIndeterminate="True" VerticalAlignment="Top" Visibility="{x:Bind h:Ui.Hide(ViewModel.IsLoaded), Mode=OneWay}" />
                </Grid>
            </Border>

            <!-- Détails -->
            <Border x:Name="DetailPane" Grid.Column="1" Style="{StaticResource CardStyle}" VerticalAlignment="Top" Visibility="{x:Bind h:Ui.Show(ViewModel.HasSelection), Mode=OneWay}">
                <Grid>
                    <StackPanel Spacing="12">
                        <TextBlock Text="{h:Str Key=Processes_Detail_Header}" Style="{StaticResource FieldLabelTextStyle}" />
                        <StackPanel Spacing="0">
                            <TextBlock Text="{x:Bind ViewModel.SelectedProcess.Name, Mode=OneWay}" Style="{StaticResource SectionHeaderTextStyle}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource CaptionSecondaryTextStyle}" IsTextSelectionEnabled="True">
                                <Run Text="{h:Str Key=Processes_Column_Pid}" /><Run Text=" " /><Run Text="{x:Bind ViewModel.SelectedProcess.ProcessIdText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.SelectedProcess.DisplayDescription, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <controls:StatusBadge Text="{x:Bind ViewModel.SelectedProcess.TrustText, Mode=OneWay}" Glyph="{x:Bind ViewModel.SelectedProcess.TrustGlyph, Mode=OneWay}" />
                            <controls:StatusBadge Text="{x:Bind ViewModel.SelectedProcess.ProtectionText, Mode=OneWay}" Glyph="{x:Bind ViewModel.SelectedProcess.ProtectionGlyph, Mode=OneWay}" Kind="Success" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{h:Str Key=Processes_Detail_Path}" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedProcess.PathText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="13" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{h:Str Key=Processes_Column_Publisher}" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedProcess.PublisherText, Mode=OneWay}" TextWrapping="Wrap" FontSize="13" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{h:Str Key=Processes_Detail_StartTime}" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedProcess.StartTimeText, Mode=OneWay}" FontSize="13" />
                        </StackPanel>
                        <Grid ColumnSpacing="8" RowSpacing="8" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Button Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" Content="{h:Str Key=Processes_Action_Close}"
                                    Command="{x:Bind ViewModel.CloseApplicationCommand}" ToolTipService.ToolTip="{h:Str Key=Processes_Action_Close_ToolTip}" />
                            <Button Grid.Column="1" Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Stretch" Content="{h:Str Key=Processes_Action_Terminate}"
                                    Command="{x:Bind ViewModel.TerminateCommand}" ToolTipService.ToolTip="{h:Str Key=Processes_Action_Terminate_ToolTip}" />
                            <Button Grid.Row="1" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" Content="{h:Str Key=Processes_Action_OpenLocation}"
                                    Command="{x:Bind ViewModel.OpenLocationCommand}" />
                            <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" Content="{h:Str Key=Processes_Action_Properties}"
                                    Command="{x:Bind ViewModel.ShowPropertiesCommand}" />
                            <Button Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Stretch" Content="{h:Str Key=Processes_Action_SearchOnline}"
                                    Command="{x:Bind ViewModel.SearchOnlineCommand}" ToolTipService.ToolTip="{h:Str Key=Processes_Action_SearchOnline_ToolTip}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</local:ViewPage>
