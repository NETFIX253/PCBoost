<!-- Surfaces : section (carte unique, jamais imbriquée), rangée de liste, tuile de mesure. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <x:Double x:Key="ContentMaxWidth">1120</x:Double>
    <Thickness x:Key="PagePadding">36,20,36,40</Thickness>
    <Thickness x:Key="CardPadding">20,16,20,18</Thickness>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <x:Double x:Key="SectionSpacing">28</x:Double>

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <!-- Rangées empilées dans une carte : séparées par un filet, pas par des cartes imbriquées. -->
    <Style x:Key="RowDividerStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="0,12,0,12" />
    </Style>

    <Style x:Key="SubtleSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="16,12,16,12" />
    </Style>

    <!-- Bande de session du mode Gaming. -->
    <Style x:Key="SessionBandStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="28,24,28,26" />
    </Style>
</ResourceDictionary>
