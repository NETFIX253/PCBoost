<Window
    x:Class="PCBoost.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:PCBoost.App.Helpers">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barre de titre personnalisée (zone de déplacement) -->
        <Grid x:Name="AppTitleBar" Height="48" Padding="16,0,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="CaptionButtonsColumn" Width="138" />
            </Grid.ColumnDefinitions>
            <Image x:Name="TitleLogo" Source="ms-appx:///Assets/Branding/logo-32.png" Width="16" Height="16" VerticalAlignment="Center"
                   AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Grid.Column="1" x:Name="TitleText" Text="{x:Bind Shell.ProductName, Mode=OneWay}" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,0">
                <Border CornerRadius="10" Padding="10,3,11,4" Background="{ThemeResource BrandAccentSubtleBrush}"
                        Visibility="{x:Bind h:Ui.Show(Shell.HasActiveProfile), Mode=OneWay}"
                        ToolTipService.ToolTip="{h:Str Key=Shell_ActiveProfile_ToolTip}">
                    <TextBlock Text="{x:Bind Shell.ActiveProfileText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource BrandAccentTextBrush}" />
                </Border>
                <Button x:Name="GamingIndicator" Padding="10,3,11,4" CornerRadius="10" MinHeight="0" BorderThickness="0"
                        Background="{ThemeResource SessionBandBrush}" Command="{x:Bind Shell.OpenGamingCommand}"
                        Visibility="{x:Bind h:Ui.Show(Shell.IsGamingModeActive), Mode=OneWay}"
                        ToolTipService.ToolTip="{h:Str Key=Shell_Gaming_ToolTip}"
                        AutomationProperties.Name="{x:Bind Shell.GamingStatusText, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="{x:Bind Shell.GamingGlyph}" FontSize="12" Foreground="{ThemeResource SessionForegroundBrush}" />
                        <TextBlock Text="{x:Bind Shell.GamingStatusText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SessionForegroundBrush}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsSettingsVisible="False"
            IsBackButtonVisible="Auto"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="264"
            CompactModeThresholdWidth="720"
            ExpandedModeThresholdWidth="1100"
            AutomationProperties.Name="{h:Str Key=Nav_AccessibleName}"
            SelectionChanged="OnNavigationSelectionChanged"
            BackRequested="OnBackRequested">

            <NavigationView.PaneFooter>
                <StackPanel x:Name="PaneFooterPanel" Padding="16,8,16,14" Spacing="10"
                            Visibility="{x:Bind h:Ui.Show(NavView.IsPaneOpen), Mode=OneWay}">
                    <Grid ColumnSpacing="10" ToolTipService.ToolTip="{h:Str Key=Shell_Protection_ToolTip}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="{x:Bind Shell.ProtectionGlyph}" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0"
                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock Text="{x:Bind Shell.ProtectionStatusText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="13" />
                            <TextBlock Text="{x:Bind Shell.ProtectionDetailText, Mode=OneWay}" Style="{StaticResource CaptionSecondaryTextStyle}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="2" Margin="-8,0,0,0">
                        <HyperlinkButton Content="{h:Str Key=Shell_Journal}" Command="{x:Bind Shell.OpenJournalCommand}" Padding="8,3,8,4" FontSize="12" />
                        <HyperlinkButton Content="{h:Str Key=Shell_Privacy}" Command="{x:Bind Shell.OpenPrivacyCommand}" Padding="8,3,8,4" FontSize="12" />
                        <HyperlinkButton Content="{h:Str Key=Shell_Support}" Command="{x:Bind Shell.OpenSupportCommand}" Padding="8,3,8,4" FontSize="12"
                                         Visibility="{x:Bind h:Ui.Show(Shell.HasSupportLink)}" />
                        <HyperlinkButton Content="{h:Str Key=Shell_About}" Command="{x:Bind Shell.OpenAboutCommand}" Padding="8,3,8,4" FontSize="12" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind Shell.VersionText, Mode=OneWay}" Style="{StaticResource CaptionSecondaryTextStyle}" />
                </StackPanel>
            </NavigationView.PaneFooter>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="8" Margin="24,12,24,0" Visibility="{x:Bind h:Ui.ShowAny(Shell.IsRecoveryBannerVisible, Shell.IsGameBannerVisible), Mode=OneWay}">
                    <InfoBar Severity="Warning" IsClosable="False"
                             h:InfoBarHelper.IsShown="{x:Bind Shell.IsRecoveryBannerVisible, Mode=OneWay}"
                             Title="{h:Str Key=Shell_Recovery_Title}"
                             Message="{x:Bind Shell.RecoveryMessage, Mode=OneWay}">
                        <InfoBar.Content>
                            <StackPanel Spacing="8" Margin="0,0,0,12">
                                <TextBlock Text="{x:Bind Shell.RecoveryDetail, Mode=OneWay}" Style="{StaticResource CaptionSecondaryTextStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="{h:Str Key=Shell_Recovery_Restore}" Command="{x:Bind Shell.RecoverCommand}" />
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="{h:Str Key=Shell_Recovery_Keep}" Command="{x:Bind Shell.KeepChangesCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </InfoBar.Content>
                    </InfoBar>
                    <InfoBar Severity="Informational" IsClosable="False"
                             h:InfoBarHelper.IsShown="{x:Bind Shell.IsGameBannerVisible, Mode=OneWay}"
                             Title="{x:Bind Shell.GameBannerTitle, Mode=OneWay}"
                             Message="{x:Bind Shell.GameBannerMessage, Mode=OneWay}">
                        <InfoBar.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,14">
                                <Button Style="{StaticResource PrimaryButtonStyle}" Content="{h:Str Key=Shell_GameBanner_Activate}" Command="{x:Bind Shell.ActivateSuggestedGamingCommand}" />
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="{h:Str Key=Shell_GameBanner_Ignore}" Command="{x:Bind Shell.IgnoreSuggestedGameCommand}" />
                            </StackPanel>
                        </InfoBar.Content>
                    </InfoBar>
                </StackPanel>
                <Frame x:Name="ContentFrame" Grid.Row="1" IsTabStop="False" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
