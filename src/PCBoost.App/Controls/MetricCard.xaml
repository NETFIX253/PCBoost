<UserControl
    x:Class="PCBoost.App.Controls.MetricCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:PCBoost.App.Helpers">
    <Border Style="{StaticResource CardStyle}" Padding="16,14,16,14" MinWidth="150">
        <Grid RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Visibility="{x:Bind h:Ui.ShowText(Glyph), Mode=OneWay}" />
                <TextBlock Text="{x:Bind Tile.Title, Mode=OneWay}" Style="{StaticResource FieldLabelTextStyle}" />
            </StackPanel>
            <TextBlock Grid.Row="1" Text="{x:Bind Tile.Value, Mode=OneWay}" Style="{StaticResource MetricValueTextStyle}"
                       FontSize="{x:Bind h:Ui.MetricValueSize(Tile.IsAvailable), Mode=OneWay}" TextWrapping="WrapWholeWords" TextTrimming="None"
                       MinHeight="36" VerticalAlignment="Bottom"
                       Opacity="{x:Bind h:Ui.Opacity(Tile.IsAvailable), Mode=OneWay}" />
            <ProgressBar Grid.Row="2" Style="{StaticResource PointsBarStyle}" Margin="0,2,0,0"
                         Value="{x:Bind Tile.Percent, Mode=OneWay}"
                         Visibility="{x:Bind h:Ui.Show(Tile.HasGauge), Mode=OneWay}"
                         AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Grid.Row="3" Text="{x:Bind Tile.Detail, Mode=OneWay}" Style="{StaticResource CaptionSecondaryTextStyle}"
                       TextWrapping="Wrap"
                       Visibility="{x:Bind h:Ui.Show(Tile.HasDetail), Mode=OneWay}" />
            <StackPanel x:Name="SecondaryPanel" Grid.Row="4" Orientation="Horizontal" Spacing="6" Margin="0,4,0,0" Visibility="Collapsed">
                <FontIcon Glyph="&#xE9CA;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="SecondaryValue" Style="{StaticResource CaptionSecondaryTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
