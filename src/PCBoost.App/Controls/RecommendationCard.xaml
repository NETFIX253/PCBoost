<UserControl
    x:Class="PCBoost.App.Controls.RecommendationCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:PCBoost.App.Helpers"
    xmlns:controls="using:PCBoost.App.Controls"
    AutomationProperties.Name="{x:Bind Item.AccessibleName, Mode=OneWay}">
    <Grid ColumnSpacing="14" Padding="0,14,0,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Width="32" Height="32" CornerRadius="16" VerticalAlignment="Top" Background="{ThemeResource BrandAccentSubtleBrush}">
            <FontIcon Glyph="{x:Bind h:Ui.Glyph(Item.KindGlyph), Mode=OneWay}" FontSize="15" Foreground="{ThemeResource BrandAccentTextBrush}" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Text="{x:Bind Item.Title, Mode=OneWay}" Style="{StaticResource GroupHeaderTextStyle}" />
            <TextBlock Text="{x:Bind Item.Description, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
            <TextBlock Text="{x:Bind Item.Reason, Mode=OneWay}" Style="{StaticResource CaptionSecondaryTextStyle}"
                       Visibility="{x:Bind h:Ui.Show(Item.HasReason), Mode=OneWay}" />
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                <controls:StatusBadge Text="{x:Bind Item.KindText, Mode=OneWay}" Kind="Info" />
                <controls:StatusBadge Text="{x:Bind Item.ImpactText, Mode=OneWay}" Kind="Neutral" Glyph="&#xE9D9;" />
                <controls:StatusBadge Text="{x:Bind Item.RiskText, Mode=OneWay}" Glyph="{x:Bind Item.RiskGlyph, Mode=OneWay}"
                                      Kind="{x:Bind RiskKind(Item.IsHighRisk), Mode=OneWay}" />
                <controls:StatusBadge Text="{x:Bind Item.ReversibleText, Mode=OneWay}" Glyph="&#xE7A7;"
                                      Kind="{x:Bind ReversibleKind(Item.IsReversible), Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Top" HorizontalAlignment="Right">
            <Button Style="{StaticResource SecondaryButtonStyle}" Content="{x:Bind Item.ActionLabel, Mode=OneWay}"
                    Command="{x:Bind Item.OpenCommand, Mode=OneWay}" HorizontalAlignment="Stretch"
                    Visibility="{x:Bind h:Ui.Show(Item.HasAction), Mode=OneWay}" />
            <Button Style="{StaticResource QuietButtonStyle}" Content="{x:Bind Item.DismissLabel, Mode=OneWay}"
                    Command="{x:Bind Item.DismissCommand, Mode=OneWay}" HorizontalAlignment="Stretch"
                    Visibility="{x:Bind DismissVisibility(Item.CanDismiss, AllowDismiss), Mode=OneWay}" />
        </StackPanel>
    </Grid>
</UserControl>
