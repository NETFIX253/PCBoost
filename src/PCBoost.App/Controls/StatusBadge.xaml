<UserControl
    x:Class="PCBoost.App.Controls.StatusBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:PCBoost.App.Helpers"
    IsTabStop="False">
    <Border x:Name="Pill" CornerRadius="10" Padding="8,2,9,3" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            HorizontalAlignment="Left" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="5">
            <FontIcon x:Name="Icon" Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="11" VerticalAlignment="Center"
                      Visibility="{x:Bind h:Ui.ShowText(Glyph), Mode=OneWay}"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="Label" Text="{x:Bind Text, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="KindStates">
                <VisualState x:Name="Neutral" />
                <VisualState x:Name="Accent">
                    <VisualState.Setters>
                        <Setter Target="Pill.Background" Value="{ThemeResource BrandAccentSubtleBrush}" />
                        <Setter Target="Icon.Foreground" Value="{ThemeResource BrandAccentTextBrush}" />
                        <Setter Target="Label.Foreground" Value="{ThemeResource BrandAccentTextBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Success">
                    <VisualState.Setters>
                        <Setter Target="Pill.Background" Value="{ThemeResource SystemFillColorSuccessBackgroundBrush}" />
                        <Setter Target="Icon.Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                        <Setter Target="Label.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Caution">
                    <VisualState.Setters>
                        <Setter Target="Pill.Background" Value="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
                        <Setter Target="Icon.Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
                        <Setter Target="Label.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Critical">
                    <VisualState.Setters>
                        <Setter Target="Pill.Background" Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
                        <Setter Target="Icon.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                        <Setter Target="Label.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Info">
                    <VisualState.Setters>
                        <Setter Target="Pill.Background" Value="{ThemeResource SystemFillColorAttentionBackgroundBrush}" />
                        <Setter Target="Icon.Foreground" Value="{ThemeResource SystemFillColorAttentionBrush}" />
                        <Setter Target="Label.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Border>
</UserControl>
