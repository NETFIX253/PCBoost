<UserControl
    x:Class="PCBoost.App.Controls.PerformanceChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <Grid x:Name="Root" MinHeight="96" Background="Transparent">
        <Path x:Name="GridLines" Stroke="{ThemeResource ChartGridBrush}" StrokeThickness="1" />
        <Path x:Name="AreaPath" Fill="{ThemeResource ChartFillBrush}" />
        <Path x:Name="LinePath" Stroke="{ThemeResource ChartLineBrush}" StrokeThickness="1.75" StrokeLineJoin="Round" />
    </Grid>
</UserControl>
