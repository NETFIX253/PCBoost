<UserControl
    x:Class="PCBoost.App.Controls.EmptyState"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <!-- État vide commun à toutes les pages : glyphe, message, centrés. -->
    <StackPanel Spacing="10" Padding="0,28,0,28" HorizontalAlignment="Center" MaxWidth="460">
        <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="32" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                  AutomationProperties.AccessibilityView="Raw" />
        <TextBlock x:Name="MessageText" Text="{x:Bind Text, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextAlignment="Center" HorizontalAlignment="Center" />
    </StackPanel>
</UserControl>
