<UserControl
    x:Class="PCBoost.App.Controls.ReportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:PCBoost.App.Helpers"
    xmlns:controls="using:PCBoost.App.Controls"
    xmlns:common="using:PCBoost.Presentation.Common">
    <Border Style="{StaticResource CardStyle}" Padding="28,24,28,26">
        <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="14">
                <Border Width="44" Height="44" CornerRadius="22" Background="{ThemeResource BrandAccentSubtleBrush}">
                    <FontIcon Glyph="{x:Bind h:Ui.Glyph(Report.StatusGlyph), Mode=OneWay}" FontSize="20" Foreground="{ThemeResource BrandAccentTextBrush}" />
                </Border>
                <TextBlock Text="{x:Bind Report.StatusTitle, Mode=OneWay}" Style="{StaticResource SectionHeaderTextStyle}" FontSize="22" VerticalAlignment="Center" />
            </StackPanel>

            <ItemsControl h:ListDividers.HideLast="True" ItemsSource="{x:Bind Report.Lines, Mode=OneWay}" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="common:InfoRowViewModel">
                        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <controls:InfoRowView Row="{x:Bind}" LabelWidth="240" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <InfoBar Severity="Informational" IsClosable="False" IsOpen="{x:Bind Report.RequiresRestart, Mode=OneWay}" Visibility="{x:Bind h:Ui.Show(Report.RequiresRestart), Mode=OneWay}"
                     Title="{h:Str Key=Common_Label_RestartRequired}" Message="{x:Bind Report.RestartText, Mode=OneWay}" />

            <StackPanel Spacing="6">
                <TextBlock Text="{h:Str Key=Optimization_Report_ResultsHeader}" Style="{StaticResource FieldLabelTextStyle}" />
                <ItemsControl ItemsSource="{x:Bind Report.Results, Mode=OneWay}" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="common:TextItemViewModel">
                            <Grid ColumnSpacing="10" Padding="0,3,0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind h:Ui.Glyph(IconGlyph)}" FontSize="13" VerticalAlignment="Top" Margin="0,3,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionSecondaryTextStyle}" Visibility="{x:Bind h:Ui.Show(HasDetail)}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="6" Visibility="{x:Bind h:Ui.Show(Report.HasWarnings), Mode=OneWay}">
                <TextBlock Text="{h:Str Key=Optimization_Report_WarningsHeader}" Style="{StaticResource FieldLabelTextStyle}" />
                <ItemsControl ItemsSource="{x:Bind Report.Warnings, Mode=OneWay}" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="common:TextItemViewModel">
                            <Grid ColumnSpacing="10" Padding="0,3,0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE7BA;" FontSize="13" VerticalAlignment="Top" Margin="0,3,0,0" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Text}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock Text="{x:Bind Report.RestoreHint, Mode=OneWay}" Style="{StaticResource CaptionSecondaryTextStyle}"
                       Visibility="{x:Bind h:Ui.ShowText(Report.RestoreHint), Mode=OneWay}" />
        </StackPanel>
    </Border>
</UserControl>
